/*------------------------------------------------------------------------------
//   本文件是 gdspx.js 的生成模板。
//
//   模板中由双大括号包围的内容是 Go template 指令，不是 JavaScript 语法。
//   代码生成器会遍历全部 Godot 接口，为每个接口展开一个 gdspx_* 方法。
//   修改生成结果 godot_modules/spx/web/js/engine/gdspx.js 时，必须同步修改本模板，
//   否则下次运行代码生成器会丢失修改。
//----------------------------------------------------------------------------*/
{{ $view := . -}}
/*
 * Go WASM 主动调用 Godot WASM 的 JavaScript 包装类。
 *
 * 初学者阅读提示：
 * - class 用来定义一类对象；new GdspxFuncs() 才会创建实际实例。
 * - constructor 是 new 时自动执行的构造函数。
 * - Module 是 Emscripten 创建的 Godot WASM 运行时对象。
 * - Module['_gdspx_xxx'] 通过字符串键取得 Godot C++ 导出的 WASM 函数。
 * - try/finally 保证即使调用抛出异常，也会释放临时分配的 WASM 内存。
 *
 * 这里只定义调用方法，不负责创建 Godot 节点，也不保存各 Manager。真正的操作
 * 最终由 _gdspx_* C++ 导出函数转发给 Godot 中的 Spx*Mgr。
 */
class GdspxFuncs {
constructor() {
	// 某些返回值用对象承载 int64 的 low/high 两部分。复用对象可减少每次调用的
	// JavaScript 临时对象分配；因此调用者若要长期保存结果，应自行复制其内容。
	this._reusableResults = {
{{- range $key, $initializer := jsResults }}
		'{{ $key }}': {{ $initializer }},
{{- end }}
	};
}

	// 以下方法由 Go template 根据接口定义批量生成。每个方法都遵循同一过程：
	// 1. 从 Module 中取得 C++/WASM 导出函数；
	// 2. 把 JavaScript 参数转换为 Godot ABI 所需的值或内存指针；
	// 3. 调用导出函数；
	// 4. 读取返回值，并在 finally 中释放临时内存。
{{- range $f := $view.CollectGDExtensionInterfaceFunctions }}
gd{{ loadProcAddressName $f.Name }}(
	{{- $args := jsArgs $f -}}
	{{- range $j, $arg := $args -}}
		{{ $arg -}}
		{{- if ne $j (sub (len $args) 1) -}}, {{- end -}}
	{{ end -}}
) {
	var _call = Module['_gd{{ loadProcAddressName $f.Name }}'];
	{{ jsBody $f }}
}
{{- end -}}
}

// 少量固定长度数组接口可以直接把结果写进共享 WASM 内存。Go 侧通过这个表按
// 接口名取得专用读取函数，避免先构造普通 JavaScript 数组再复制一次。
GdspxFuncs['arrayOutputs'] = {
{{- range $f := $view.CollectGDExtensionInterfaceFunctions }}
{{- $spec := arrayBridge $f.Name }}
{{- $output := $spec.FixedOutput }}
{{- if and $output (not (hasEffectiveReturn $f)) }}
	'gd{{ loadProcAddressName $f.Name }}': function() {
		return ReadArrayOutput('_gd{{ loadProcAddressName $f.Name }}', {{ $output.Type }}, {{ $output.Count }});
	},
{{- end }}
{{- end }}
};

// 使用 ['字符串键'] 再导出一次原型方法，是为了让 Closure Compiler 压缩时保留
// 对外可见的方法名。globalThis 在普通页面中通常是 window，在 Worker 中是 self。
{{- range $f := $view.CollectGDExtensionInterfaceFunctions }}
GdspxFuncs.prototype['gd{{ loadProcAddressName $f.Name }}'] = GdspxFuncs.prototype.gd{{ loadProcAddressName $f.Name }};
{{- end }}
globalThis['GdspxFuncs'] = GdspxFuncs;
