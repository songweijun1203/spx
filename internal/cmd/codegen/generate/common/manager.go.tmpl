// BindMgr 把平台 Manager 实例赋给 engine 包的一组全局接口变量。
// 调用时机：gdengine.PrepareLink() 创建完全部 Manager 后；后续游戏代码通过
// AudioMgr、SpriteMgr 等接口调用具体平台实现。
func BindMgr(mgrs []IManager) {
	for _, mgr := range mgrs {
		switch v := mgr.(type) {
{{- range $name := .Managers }}
		case I{{camelCase $name}}Mgr:
			{{camelCase $name}}Mgr = v
{{ end }}
		default:
			panic(fmt.Sprintf("engine init error : unknown manager type %s", reflect.TypeOf(mgr).String()))
		}
	}
}

{{ range $name := .Managers -}}
type {{$name}}Mgr struct {
	baseMgr
}
{{ end }}

// createMgrs 创建当前平台的全部 Manager，具体方法体由平台模板提供的生成函数决定。
// 直接上级：manager_base.go 的 CreateMgrs()。
func createMgrs() []IManager {
{{- range $name := .Managers }}
	addManager(&{{$name}}Mgr{})
{{- end }}
	return mgrs
}

